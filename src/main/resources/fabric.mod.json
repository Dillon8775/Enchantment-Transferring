{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}+${mc_version}",
  "name": "Enchantment Transferring",
  "description": "Transfer enchantments from one item, to another!",
  "authors": [
    "Dillon8775"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/enchantment-transferring",
    "sources": "https://github.com/Dillon8775/Enchantment-Transferring",
    "issues": "https://github.com/Dillon8775/Enchantment-Transferring/issues"
  },
  "license": "All rights reserved.",
  "icon": "assets/enchantmenttransferring/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dillon.enchantmenttransferring.main.EtInitializer"
    ],
    "client": [
      "net.dillon.enchantmenttransferring.main.EtClientInitializer"
    ],
    "fabric-datagen": [
      "net.dillon.enchantmenttransferring.datagen.EnchantmentTransferringDataGenerator"
    ]
  },
  "mixins": [
    "enchantmenttransferring.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=${java_version}",
    "fabric-api": "*",
    "dillonlib": ">=${dillonlib_version}"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/vfqEAn4YFy"
      }
    }
  }
}